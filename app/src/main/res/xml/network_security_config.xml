<?xml version="1.0" encoding="utf-8"?>
<!--
    Android bloquea HTTP sin cifrar por defecto. Los microservicios corren en el PC con http://,
    así que se permite SOLO hacia el PC (emulador: 10.0.2.2). El resto de internet sigue exigiendo HTTPS
    (la API externa usa https://api.artic.edu).
    En un teléfono físico agrega aquí la IP de tu PC, por ejemplo <domain>192.168.1.20</domain>.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
